{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "bank_name": {
      "type": "string",
      "description": "Bank or financial institution name"
    },
    "account_name": {
      "type": "string",
      "description": "Account holder or account nickname"
    },
    "account_number": {
      "type": "string",
      "description": "Last 4 digits or masked account number"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "checking",
        "savings",
        "money_market",
        "line_of_credit",
        "other"
      ],
      "description": "Type of bank account"
    },
    "current_balance": {
      "type": "number",
      "description": "Current account balance"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "closed"
      ],
      "default": "active"
    }
  },
  "required": [
    "bank_name",
    "account_name",
    "current_balance"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}