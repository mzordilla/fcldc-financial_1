{
  "name": "PayrollPeriod",
  "type": "object",
  "properties": {
    "period_label": {
      "type": "string",
      "description": "e.g. June 1-15, 2026"
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "pay_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "processing",
        "approved",
        "processed"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "period_label",
    "period_start",
    "period_end"
  ]
}