{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_name": {
      "type": "string",
      "description": "Project name"
    },
    "project_code": {
      "type": "string",
      "description": "Unique project code for transactions (e.g., PRJ-2026-001)"
    },
    "client_id": {
      "type": "string",
      "description": "Linked Client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client / owner name (denormalized for display)"
    },
    "project_number": {
      "type": "string",
      "description": "Internal project reference number"
    },
    "location": {
      "type": "string",
      "description": "Project site location"
    },
    "project_type": {
      "type": "string",
      "enum": [
        "residential",
        "commercial",
        "industrial",
        "infrastructure",
        "renovation",
        "other"
      ]
    },
    "project_classification": {
      "type": "string",
      "enum": [
        "owned_project",
        "client_project",
        "monitoring_project"
      ],
      "description": "Classification of the project: Owned Project, Client Project, or Monitoring Project"
    },
    "contract_amount": {
      "type": "number",
      "description": "Primary/original contract value for Client Projects only"
    },
    "completed_percentage": {
      "type": "number",
      "description": "Percentage of work completed (0-100)",
      "minimum": 0,
      "maximum": 100
    },
    "retention_rate": {
      "type": "number",
      "description": "Retention percentage held by client (e.g. 5 for 5%)",
      "minimum": 0,
      "maximum": 100
    },
    "contract_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "active",
        "completed",
        "on_hold",
        "cancelled"
      ],
      "default": "pending"
    },
    "contract_date": {
      "type": "string",
      "format": "date",
      "description": "Contract signing date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Expected completion date"
    },
    "project_manager": {
      "type": "string"
    },
    "scope_of_works": {
      "type": "string",
      "description": "Detailed scope of works for the project"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "project_name",
    "project_code",
    "client_name"
  ]
}