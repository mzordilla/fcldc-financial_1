{
  "name": "PPEAsset",
  "type": "object",
  "properties": {
    "asset_name": {
      "type": "string",
      "description": "Name or description of the asset"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "land",
        "vehicle",
        "furniture_and_fixture",
        "building",
        "equipment",
        "heavy_equipment",
        "other"
      ],
      "description": "Type/category of PPE asset"
    },
    "asset_code": {
      "type": "string",
      "description": "Internal asset reference code"
    },
    "title_no": {
      "type": "string",
      "description": "Land/property title number"
    },
    "area_sqm": {
      "type": "number",
      "description": "Area in square meters"
    },
    "acquisition_date": {
      "type": "string",
      "format": "date",
      "description": "Date the asset was acquired"
    },
    "acquisition_cost": {
      "type": "number",
      "description": "Original cost of the asset"
    },
    "useful_life_years": {
      "type": "number",
      "description": "Estimated useful life in years"
    },
    "depreciation_method": {
      "type": "string",
      "enum": [
        "straight_line",
        "declining_balance",
        "none"
      ],
      "default": "straight_line"
    },
    "salvage_value": {
      "type": "number",
      "default": 0,
      "description": "Residual value; automatically set to 10% of original cost for straight-line depreciation"
    },
    "accumulated_depreciation": {
      "type": "number",
      "default": 0
    },
    "book_value": {
      "type": "number",
      "description": "Current book value before revaluation"
    },
    "market_value": {
      "type": "number",
      "description": "Current appraised market value"
    },
    "revaluation_surplus": {
      "type": "number",
      "default": 0,
      "description": "Market value less book value; included in equity"
    },
    "insurance_cost": {
      "type": "number",
      "default": 0
    },
    "insurance_provider": {
      "type": "string"
    },
    "insurance_policy_number": {
      "type": "string"
    },
    "insurance_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "registration_cost": {
      "type": "number",
      "default": 0
    },
    "registration_number": {
      "type": "string"
    },
    "registration_expiry_date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disposed",
        "under_maintenance",
        "fully_depreciated"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "asset_name",
    "asset_type",
    "acquisition_cost"
  ]
}