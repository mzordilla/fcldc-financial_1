{
  "name": "ChangeOrder",
  "type": "object",
  "properties": {
    "co_number": {
      "type": "string",
      "description": "Change Order reference number (e.g. CO-001)"
    },
    "contract_id": {
      "type": "string",
      "description": "Linked Contract ID (parent contract)"
    },
    "project_id": {
      "type": "string",
      "description": "Linked Project ID"
    },
    "project_name": {
      "type": "string",
      "description": "Project name (denormalized)"
    },
    "co_type": {
      "type": "string",
      "enum": [
        "additive",
        "deductive"
      ],
      "description": "Whether this CO increases or decreases the contract amount"
    },
    "amount": {
      "type": "number",
      "description": "Change Order amount (always positive; co_type determines direction)"
    },
    "description": {
      "type": "string",
      "description": "Scope of change / reason for the Change Order"
    },
    "scope_change": {
      "type": "string",
      "description": "Detailed description of what scope is being changed"
    },
    "quantity_adjustment": {
      "type": "string",
      "description": "Notes on quantity changes (e.g. +50 pcs steel bars)"
    },
    "pricing_adjustment": {
      "type": "string",
      "description": "Notes on unit price changes"
    },
    "date_issued": {
      "type": "string",
      "format": "date",
      "description": "Date the CO was issued"
    },
    "date_approved": {
      "type": "string",
      "format": "date",
      "description": "Date the CO was approved"
    },
    "timeline_impact_days": {
      "type": "number",
      "default": 0,
      "description": "Number of days added to or removed from project timeline (positive = extension)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending",
      "description": "Approval status of the Change Order"
    },
    "approved_by": {
      "type": "string",
      "description": "Name of the person who approved the CO"
    },
    "revision_history": {
      "type": "array",
      "description": "Log of all revisions made to this Change Order",
      "items": {
        "type": "object",
        "properties": {
          "revision_number": {
            "type": "string"
          },
          "revised_by": {
            "type": "string"
          },
          "revised_at": {
            "type": "string"
          },
          "previous_amount": {
            "type": "number"
          },
          "new_amount": {
            "type": "number"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or remarks"
    }
  },
  "required": [
    "project_id",
    "co_type",
    "amount",
    "description"
  ]
}