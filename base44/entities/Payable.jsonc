{
  "name": "Payable",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string",
      "description": "Supplier or vendor name"
    },
    "description": {
      "type": "string",
      "description": "What is owed for"
    },
    "invoice_number": {
      "type": "string",
      "description": "Supplier invoice reference"
    },
    "po_id": {
      "type": "string",
      "description": "Linked Purchase Order ID"
    },
    "po_number": {
      "type": "string",
      "description": "Purchase Order number (denormalized)"
    },
    "amount": {
      "type": "number",
      "description": "Total amount owed"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount already paid"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "project_name": {
      "type": "string",
      "description": "Associated project"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "equipment",
        "subcontractor",
        "services",
        "utilities",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partially_paid",
        "paid",
        "overdue"
      ],
      "default": "unpaid"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date payment was made"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "check",
        "cash",
        "credit_card",
        "other"
      ],
      "description": "How payment was made"
    },
    "payment_reference": {
      "type": "string",
      "description": "Check number, transfer reference, receipt number, etc."
    },
    "payment_notes": {
      "type": "string",
      "description": "Additional notes about the payment"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_name",
    "amount",
    "due_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        },
        {
          "user_condition": {
            "role": "procurement"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        },
        {
          "user_condition": {
            "role": "procurement"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        },
        {
          "user_condition": {
            "role": "procurement"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}