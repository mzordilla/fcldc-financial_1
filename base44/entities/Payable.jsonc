{
  "name": "Payable",
  "type": "object",
  "properties": {
    "supplier_name": {
      "type": "string",
      "description": "Supplier or vendor name"
    },
    "description": {
      "type": "string",
      "description": "What is owed for"
    },
    "invoice_number": {
      "type": "string",
      "description": "Supplier invoice reference"
    },
    "po_id": {
      "type": "string",
      "description": "Linked Purchase Order ID"
    },
    "po_number": {
      "type": "string",
      "description": "Purchase Order number (denormalized)"
    },
    "amount": {
      "type": "number",
      "description": "Total gross amount owed (before withholding tax deduction)"
    },
    "withholding_tax_percentage": {
      "type": "number",
      "default": 0,
      "description": "Withholding tax percentage (e.g. 2 for 2%)"
    },
    "withholding_tax_amount": {
      "type": "number",
      "default": 0,
      "description": "Withholding tax amount deducted from gross \u2014 net payable = amount - withholding_tax_amount"
    },
    "vat_percentage": {
      "type": "number",
      "default": 0,
      "description": "VAT percentage (e.g. 12 for 12%)"
    },
    "vat_amount": {
      "type": "number",
      "default": 0,
      "description": "VAT amount added"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Net cash amount already paid (gross minus withholding tax)"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "project_name": {
      "type": "string",
      "description": "Associated project"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "equipment",
        "subcontractor",
        "services",
        "utilities",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "unpaid",
        "partially_paid",
        "paid",
        "overdue"
      ],
      "default": "unpaid"
    },
    "payment_history": {
      "type": "array",
      "description": "Log of all partial and full payments made",
      "items": {
        "type": "object",
        "properties": {
          "payment_date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "payment_method": {
            "type": "string"
          },
          "bank_account_id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Date of last payment"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "check",
        "cash",
        "credit_card",
        "other"
      ],
      "description": "Method of last payment"
    },
    "payment_reference": {
      "type": "string",
      "description": "Check number, transfer reference, receipt number, etc."
    },
    "payment_notes": {
      "type": "string",
      "description": "Additional notes about the payment"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "supplier_name",
    "amount",
    "due_date"
  ]
}