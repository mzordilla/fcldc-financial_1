{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "description": "Description of the transaction"
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Transaction type"
    },
    "category": {
      "type": "string",
      "enum": [
        "project_payment",
        "material_cost",
        "labor",
        "equipment",
        "subcontractor",
        "overhead",
        "permits",
        "insurance",
        "bank_reconciliation",
        "other"
      ],
      "description": "Transaction category"
    },
    "project_name": {
      "type": "string",
      "description": "Associated project name"
    },
    "bank_account_id": {
      "type": "string",
      "description": "Linked bank account ID"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Transaction date"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "pending",
        "cancelled"
      ],
      "default": "completed"
    }
  },
  "required": [
    "description",
    "amount",
    "type",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}