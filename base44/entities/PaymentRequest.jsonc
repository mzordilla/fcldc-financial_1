{
  "name": "PaymentRequest",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string",
      "description": "Payment request reference number"
    },
    "payee": {
      "type": "string",
      "description": "Who is being paid"
    },
    "project_allocations": {
      "type": "array",
      "description": "List of project allocations with amounts",
      "items": {
        "type": "object",
        "properties": {
          "project_name": {
            "type": "string"
          },
          "project_code": {
            "type": "string",
            "description": "Project code for expense mapping"
          },
          "amount": {
            "type": "number"
          },
          "category": {
            "type": "string"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Reason for payment"
    },
    "amount": {
      "type": "number",
      "description": "Total payment amount"
    },
    "category": {
      "type": "string",
      "enum": [
        "supplier_invoice",
        "material_cost",
        "subcontractor",
        "labor",
        "equipment",
        "expense_reimbursement",
        "utilities",
        "other"
      ]
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "bank_transfer",
        "check",
        "cash",
        "credit_card",
        "other"
      ],
      "default": "bank_transfer"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "requested_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "paid"
      ],
      "default": "pending"
    },
    "approval_step": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewed",
        "approved",
        "rejected",
        "paid"
      ],
      "default": "submitted",
      "description": "Current step in the approval workflow"
    },
    "approval_notes": {
      "type": "string"
    },
    "approval_history": {
      "type": "array",
      "description": "Audit log of all approval actions",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "supporting_docs": {
      "type": "string",
      "description": "Reference to attached documents"
    },
    "attachments": {
      "type": "array",
      "description": "Uploaded supporting documents (PDF, images, other files)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "check_number": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string",
      "description": "Linked BankAccount ID the check/payment was disbursed from"
    },
    "check_date": {
      "type": "string",
      "format": "date"
    },
    "check_attachment": {
      "type": "string",
      "description": "URL of uploaded check image"
    },
    "withholding_tax_percentage": {
      "type": "number",
      "default": 0
    },
    "withholding_tax_amount": {
      "type": "number",
      "default": 0
    },
    "vat_percentage": {
      "type": "number",
      "default": 0
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "payee",
    "amount",
    "description"
  ]
}