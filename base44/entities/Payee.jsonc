{
  "name": "Payee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Payee name"
    },
    "category": {
      "type": "string",
      "enum": [
        "supplier",
        "subcontractor",
        "employee",
        "government",
        "utility",
        "other"
      ],
      "description": "Type of payee"
    },
    "contact": {
      "type": "string",
      "description": "Contact number or email"
    },
    "credit_limit": {
      "type": "number",
      "description": "Credit limit or cash available per supplier"
    },
    "bank_account_name": {
      "type": "string",
      "description": "Bank account holder name"
    },
    "bank_account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name"
  ]
}