{
  "name": "Payee",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Payee name"
    },
    "category": {
      "type": "string",
      "enum": [
        "supplier",
        "subcontractor",
        "employee",
        "government",
        "utility",
        "other"
      ],
      "description": "Type of payee"
    },
    "contact": {
      "type": "string",
      "description": "Contact number or email"
    },
    "credit_limit": {
      "type": "number",
      "description": "Credit limit or cash available per supplier"
    },
    "bank_account_name": {
      "type": "string",
      "description": "Bank account holder name"
    },
    "bank_account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "terms_of_payment": {
      "type": "string",
      "description": "Payment terms (e.g., Net 30, COD, Net 60)"
    },
    "vat_status": {
      "type": "string",
      "enum": [
        "vat",
        "non_vat"
      ],
      "description": "VAT or Non-VAT registered"
    },
    "is_accredited": {
      "type": "boolean",
      "default": false,
      "description": "Whether the supplier/payee is accredited"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    }
  },
  "required": [
    "name"
  ]
}