{
  "name": "WorkingCapitalLoan",
  "type": "object",
  "properties": {
    "creditor": {
      "type": "string",
      "description": "Creditor or lender name"
    },
    "description": {
      "type": "string",
      "description": "Description of the working capital loan"
    },
    "amount_granted": {
      "type": "number",
      "description": "Total amount granted by lender"
    },
    "amount_availed": {
      "type": "number",
      "default": 0,
      "description": "Amount that has been drawn/utilized"
    },
    "total_amount": {
      "type": "number",
      "description": "Total loan amount"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount already paid off"
    },
    "principal_balance": {
      "type": "number",
      "default": 0,
      "description": "Remaining principal balance"
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate percentage"
    },
    "interest_accrued_1yr": {
      "type": "number",
      "default": 0,
      "description": "Interest accrued over 1 year"
    },
    "monthly_payment": {
      "type": "number",
      "description": "Monthly payment amount"
    },
    "loan_granted": {
      "type": "string",
      "format": "date",
      "description": "Date when loan was granted"
    },
    "loan_availed": {
      "type": "string",
      "format": "date",
      "description": "Date when loan was actually drawn/used"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Final payment due date"
    },
    "type": {
      "type": "string",
      "enum": [
        "loan",
        "credit_line",
        "equipment_financing",
        "vendor_credit",
        "mortgage",
        "other"
      ],
      "description": "Type of working capital loan"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paid_off",
        "defaulted"
      ],
      "default": "active"
    }
  },
  "required": [
    "creditor",
    "total_amount",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}