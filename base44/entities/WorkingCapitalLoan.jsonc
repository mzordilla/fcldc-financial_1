{
  "name": "WorkingCapitalLoan",
  "type": "object",
  "properties": {
    "creditor": {
      "type": "string",
      "description": "Creditor or lender name"
    },
    "description": {
      "type": "string",
      "description": "Description of the working capital loan"
    },
    "total_amount": {
      "type": "number",
      "description": "Total loan amount"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount already paid off"
    },
    "interest_rate": {
      "type": "number",
      "description": "Annual interest rate percentage"
    },
    "monthly_payment": {
      "type": "number",
      "description": "Monthly payment amount"
    },
    "loan_granted": {
      "type": "string",
      "format": "date",
      "description": "Date when loan was granted"
    },
    "loan_availed": {
      "type": "string",
      "format": "date",
      "description": "Date when loan was actually drawn/used"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Final payment due date"
    },
    "type": {
      "type": "string",
      "enum": [
        "loan",
        "credit_line",
        "equipment_financing",
        "vendor_credit",
        "mortgage",
        "other"
      ],
      "description": "Type of working capital loan"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paid_off",
        "defaulted"
      ],
      "default": "active"
    }
  },
  "required": [
    "creditor",
    "total_amount",
    "type"
  ]
}