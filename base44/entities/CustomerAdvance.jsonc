{
  "name": "CustomerAdvance",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Linked Client ID"
    },
    "client_name": {
      "type": "string",
      "description": "Client name"
    },
    "amount": {
      "type": "number",
      "description": "Total advance received (initial + all collections)"
    },
    "applied_amount": {
      "type": "number",
      "default": 0,
      "description": "Amount applied to receivables"
    },
    "available_balance": {
      "type": "number",
      "description": "Remaining unapplied liability"
    },
    "received_date": {
      "type": "string",
      "format": "date"
    },
    "bank_account_id": {
      "type": "string",
      "description": "Bank account where the advance was deposited"
    },
    "reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "partially_applied",
        "fully_applied"
      ],
      "default": "available"
    },
    "collections": {
      "type": "array",
      "description": "Additional collections received against this advance",
      "items": {
        "type": "object",
        "properties": {
          "collection_date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "bank_account_id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "receipt_url": {
            "type": "string"
          },
          "check_image_url": {
            "type": "string"
          },
          "transaction_id": {
            "type": "string"
          }
        }
      }
    },
    "application_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "receivable_id": {
            "type": "string"
          },
          "invoice_number": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "application_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "required": [
    "client_id",
    "client_name",
    "amount",
    "received_date"
  ]
}