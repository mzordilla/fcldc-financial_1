{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Purchase order number"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "project_name": {
      "type": "string",
      "description": "Associated project"
    },
    "project_code": {
      "type": "string",
      "description": "Associated project code (e.g. PRJ-2026-001)"
    },
    "description": {
      "type": "string",
      "description": "What is being purchased"
    },
    "line_items": {
      "type": "array",
      "description": "Itemized line items with quantity and cost",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_of_measure": {
            "type": "string",
            "description": "Unit of measure (e.g., pcs, kg, m, etc.)"
          },
          "cost_per_item": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "description": "Supporting documents (PDF, images, other files) uploaded for this purchase order",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "string",
      "description": "Line items (comma separated or details)"
    },
    "amount": {
      "type": "number",
      "description": "Grand total PO amount including VAT when applicable"
    },
    "vat_treatment": {
      "type": "string",
      "enum": [
        "vat_inclusive",
        "vat_exclusive",
        "non_vat"
      ],
      "default": "non_vat",
      "description": "Whether entered purchase prices include VAT, exclude VAT, or are non-VAT"
    },
    "vat_percentage": {
      "type": "number",
      "default": 12,
      "description": "VAT rate applied to this purchase order"
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Purchase amount before VAT"
    },
    "vat_amount": {
      "type": "number",
      "default": 0,
      "description": "VAT portion of the purchase order"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "equipment",
        "subcontractor",
        "services",
        "utilities",
        "other",
        "project_payment",
        "material_cost",
        "labor",
        "overhead",
        "permits",
        "insurance",
        "bank_reconciliation",
        "non_current_assets",
        "current_assets",
        "current_liabilities",
        "non_current_liabilities",
        "repair_and_maintenance",
        "fixtures"
      ]
    },
    "chart_of_account": {
      "type": "string",
      "description": "Linked Chart of Account name"
    },
    "requested_by": {
      "type": "string",
      "description": "Person requesting the purchase"
    },
    "approved_by": {
      "type": "string",
      "description": "Person who approved"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "required_date": {
      "type": "string",
      "format": "date",
      "description": "Date materials/services needed"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "approval_notes": {
      "type": "string",
      "description": "Notes from approver"
    },
    "approval_step": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewed",
        "approved",
        "rejected"
      ],
      "default": "submitted",
      "description": "Current step in the approval workflow"
    },
    "approval_history": {
      "type": "array",
      "description": "Audit log of all approval actions",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt/delivery document URL"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Date goods/services were delivered"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes about delivery condition or inspection"
    },
    "change_requests": {
      "type": "array",
      "description": "Requests to change price, quantity, or supplier on an already-approved PO",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "price",
              "quantity",
              "supplier"
            ]
          },
          "line_item_description": {
            "type": "string",
            "description": "Which line item this quantity change applies to, if any"
          },
          "current_value": {
            "type": "string"
          },
          "requested_value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requested_by": {
            "type": "string"
          },
          "requested_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "default": "pending"
          },
          "reviewed_by": {
            "type": "string"
          },
          "review_notes": {
            "type": "string"
          },
          "reviewed_date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "supplier_name",
    "amount",
    "description"
  ]
}