{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Purchase order number"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "project_name": {
      "type": "string",
      "description": "Associated project"
    },
    "description": {
      "type": "string",
      "description": "What is being purchased"
    },
    "line_items": {
      "type": "array",
      "description": "Itemized line items with quantity and cost",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "cost_per_item": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "items": {
      "type": "string",
      "description": "Line items (comma separated or details)"
    },
    "amount": {
      "type": "number",
      "description": "Total PO amount"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "equipment",
        "subcontractor",
        "services",
        "utilities",
        "other"
      ]
    },
    "requested_by": {
      "type": "string",
      "description": "Person requesting the purchase"
    },
    "approved_by": {
      "type": "string",
      "description": "Person who approved"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "required_date": {
      "type": "string",
      "format": "date",
      "description": "Date materials/services needed"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "approval_notes": {
      "type": "string",
      "description": "Notes from approver"
    },
    "approval_step": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewed",
        "approved",
        "rejected"
      ],
      "default": "submitted",
      "description": "Current step in the approval workflow"
    },
    "approval_history": {
      "type": "array",
      "description": "Audit log of all approval actions",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "receipt_url": {
      "type": "string",
      "description": "Uploaded receipt/delivery document URL"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Date goods/services were delivered"
    },
    "delivery_notes": {
      "type": "string",
      "description": "Notes about delivery condition or inspection"
    }
  },
  "required": [
    "supplier_name",
    "amount",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "procurement"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "procurement"
          }
        },
        {
          "user_condition": {
            "role": "accounting"
          }
        }
      ]
    },
    "update": null,
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}