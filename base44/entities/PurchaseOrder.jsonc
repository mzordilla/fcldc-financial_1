{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Purchase order number"
    },
    "supplier_name": {
      "type": "string",
      "description": "Supplier name"
    },
    "project_name": {
      "type": "string",
      "description": "Associated project"
    },
    "project_code": {
      "type": "string",
      "description": "Associated project code (e.g. PRJ-2026-001)"
    },
    "description": {
      "type": "string",
      "description": "What is being purchased"
    },
    "line_items": {
      "type": "array",
      "description": "Itemized line items with quantity and cost",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_of_measure": {
            "type": "string",
            "description": "Unit of measure"
          },
          "cost_per_item": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "attachments": {
      "type": "array",
      "description": "Supporting documents",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "string",
      "description": "Additional line item details"
    },
    "amount": {
      "type": "number",
      "description": "Net payable amount after VAT and deductions"
    },
    "vat_treatment": {
      "type": "string",
      "enum": [
        "vat_inclusive",
        "vat_exclusive",
        "non_vat"
      ],
      "default": "non_vat"
    },
    "vat_percentage": {
      "type": "number",
      "default": 12
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Purchase amount before VAT and deductions"
    },
    "vat_amount": {
      "type": "number",
      "default": 0
    },
    "deductions": {
      "type": "array",
      "description": "Deductions calculated from the pre-VAT subtotal",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "percentage": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          },
          "chart_of_account": {
            "type": "string"
          },
          "account_code": {
            "type": "string"
          }
        },
        "required": [
          "description",
          "percentage",
          "amount",
          "chart_of_account"
        ]
      }
    },
    "total_deductions": {
      "type": "number",
      "default": 0,
      "description": "Total deductions from the pre-VAT subtotal"
    },
    "category": {
      "type": "string",
      "enum": [
        "materials",
        "equipment",
        "subcontractor",
        "services",
        "utilities",
        "other",
        "project_payment",
        "material_cost",
        "labor",
        "overhead",
        "permits",
        "insurance",
        "bank_reconciliation",
        "non_current_assets",
        "current_assets",
        "current_liabilities",
        "non_current_liabilities",
        "repair_and_maintenance",
        "fixtures"
      ]
    },
    "chart_of_account": {
      "type": "string",
      "description": "Linked Chart of Account name"
    },
    "requested_by": {
      "type": "string"
    },
    "approved_by": {
      "type": "string"
    },
    "requested_date": {
      "type": "string",
      "format": "date"
    },
    "required_date": {
      "type": "string",
      "format": "date"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending"
    },
    "approval_notes": {
      "type": "string"
    },
    "approval_step": {
      "type": "string",
      "enum": [
        "submitted",
        "reviewed",
        "approved",
        "rejected"
      ],
      "default": "submitted"
    },
    "approval_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          }
        }
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal"
    },
    "receipt_url": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "delivery_notes": {
      "type": "string"
    },
    "change_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": [
              "price",
              "quantity",
              "supplier"
            ]
          },
          "line_item_description": {
            "type": "string"
          },
          "current_value": {
            "type": "string"
          },
          "requested_value": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "requested_by": {
            "type": "string"
          },
          "requested_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ],
            "default": "pending"
          },
          "reviewed_by": {
            "type": "string"
          },
          "review_notes": {
            "type": "string"
          },
          "reviewed_date": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "supplier_name",
    "amount",
    "description"
  ]
}