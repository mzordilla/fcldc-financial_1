{
  "name": "Receivable",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Client or company name"
    },
    "project_name": {
      "type": "string",
      "description": "Project name"
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice reference number"
    },
    "property_listing_id": {
      "type": "string",
      "description": "Linked sold PropertyListing ID"
    },
    "receivable_type": {
      "type": "string",
      "enum": [
        "project",
        "funding_loan",
        "employee"
      ],
      "default": "project",
      "description": "Whether this is a project billing receivable, a funding/loan receivable, or an employee receivable (cash advance / loan to an employee)"
    },
    "funding_purpose": {
      "type": "string",
      "enum": [
        "renovation",
        "acquisition",
        "funding"
      ],
      "description": "Classification of a funding/loan receivable: renovation, acquisition, or funding"
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount before applied advance payments"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount paid or credited against the receivable"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "status": {
      "type": "string",
      "enum": [
        "outstanding",
        "partially_paid",
        "paid",
        "overdue"
      ],
      "default": "outstanding"
    },
    "payment_history": {
      "type": "array",
      "description": "Log of advance credits and all partial and full collections",
      "items": {
        "type": "object",
        "properties": {
          "collection_date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "bank_account_id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "is_advance_payment": {
            "type": "boolean",
            "description": "Whether this entry applies an advance payment already received"
          },
          "receipt_url": {
            "type": "string",
            "description": "URL of uploaded receipt/image"
          },
          "check_image_url": {
            "type": "string",
            "description": "URL of uploaded check image"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "amount",
    "due_date"
  ]
}