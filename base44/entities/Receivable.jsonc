{
  "name": "Receivable",
  "type": "object",
  "properties": {
    "client_name": {
      "type": "string",
      "description": "Client or company name"
    },
    "project_name": {
      "type": "string",
      "description": "Project name"
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice reference number"
    },
    "property_listing_id": {
      "type": "string",
      "description": "Linked sold PropertyListing ID"
    },
    "amount": {
      "type": "number",
      "description": "Total invoice amount"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount already collected"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Payment due date"
    },
    "status": {
      "type": "string",
      "enum": [
        "outstanding",
        "partially_paid",
        "paid",
        "overdue"
      ],
      "default": "outstanding"
    },
    "payment_history": {
      "type": "array",
      "description": "Log of all partial and full collections",
      "items": {
        "type": "object",
        "properties": {
          "collection_date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "bank_account_id": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "receipt_url": {
            "type": "string",
            "description": "URL of uploaded receipt/image"
          },
          "check_image_url": {
            "type": "string",
            "description": "URL of uploaded check image"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "client_name",
    "amount",
    "due_date"
  ]
}