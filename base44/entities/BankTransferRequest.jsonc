{
  "name": "BankTransferRequest",
  "type": "object",
  "properties": {
    "transfers": {
      "type": "array",
      "description": "Bank-to-bank transfer lines included in this approval request",
      "items": {
        "type": "object",
        "properties": {
          "from_bank_account_id": {
            "type": "string"
          },
          "from_bank_name": {
            "type": "string"
          },
          "to_bank_account_id": {
            "type": "string"
          },
          "to_bank_name": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        },
        "required": [
          "from_bank_account_id",
          "to_bank_account_id",
          "amount"
        ]
      }
    },
    "from_bank_account_id": {
      "type": "string",
      "description": "Legacy source bank account ID"
    },
    "from_bank_name": {
      "type": "string",
      "description": "Legacy source account display name"
    },
    "to_bank_account_id": {
      "type": "string",
      "description": "Legacy destination bank account ID"
    },
    "to_bank_name": {
      "type": "string",
      "description": "Legacy destination account display name"
    },
    "amount": {
      "type": "number",
      "description": "Total requested transfer amount"
    },
    "transfer_date": {
      "type": "string",
      "format": "date"
    },
    "reference": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "amount",
    "transfer_date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    }
  }
}