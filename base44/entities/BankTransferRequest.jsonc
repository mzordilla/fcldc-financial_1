{
  "name": "BankTransferRequest",
  "type": "object",
  "properties": {
    "from_bank_account_id": {
      "type": "string",
      "description": "Source bank account ID"
    },
    "from_bank_name": {
      "type": "string",
      "description": "Source account display name"
    },
    "to_bank_account_id": {
      "type": "string",
      "description": "Destination bank account ID"
    },
    "to_bank_name": {
      "type": "string",
      "description": "Destination account display name"
    },
    "amount": {
      "type": "number",
      "description": "Requested transfer amount"
    },
    "transfer_date": {
      "type": "string",
      "format": "date"
    },
    "reference": {
      "type": "string"
    },
    "requested_by_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string"
    },
    "review_notes": {
      "type": "string"
    }
  },
  "required": [
    "from_bank_account_id",
    "to_bank_account_id",
    "amount",
    "transfer_date",
    "status"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$and": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.status": "pending"
        }
      ]
    }
  }
}