{
  "name": "PropertyListing",
  "type": "object",
  "properties": {
    "units": {
      "type": "array",
      "description": "Condo units linked to this listing (one client/listing can cover multiple units)",
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "unit_number": {
            "type": "string"
          },
          "building": {
            "type": "string"
          }
        }
      }
    },
    "listing_type": {
      "type": "string",
      "enum": [
        "for_sale",
        "for_lease"
      ],
      "description": "Type of listing"
    },
    "asking_price": {
      "type": "number",
      "description": "Asking price or monthly rent"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_negotiation",
        "sold",
        "leased",
        "cancelled",
        "online",
        "inquiry",
        "rejected",
        "declined",
        "impasse"
      ],
      "default": "active",
      "description": "Listing status"
    },
    "client_id": {
      "type": "string",
      "description": "Linked Client ID from the Client masterlist"
    },
    "buyer_tenant_name": {
      "type": "string",
      "description": "Interested or confirmed buyer/tenant name (denormalized from linked Client)"
    },
    "buyer_tenant_contact": {
      "type": "string",
      "description": "Contact number or email"
    },
    "date_listed": {
      "type": "string",
      "format": "date",
      "description": "Date the listing was created"
    },
    "date_closed": {
      "type": "string",
      "format": "date",
      "description": "Date the deal was closed"
    },
    "final_price": {
      "type": "number",
      "description": "Final agreed price or rent"
    },
    "agent": {
      "type": "string",
      "description": "Handling agent or broker"
    },
    "contract_attachment_url": {
      "type": "string",
      "description": "URL of the uploaded sale/lease contract document"
    },
    "payment_history": {
      "type": "array",
      "description": "Log of all payments collected from the client for this sold/leased listing",
      "items": {
        "type": "object",
        "properties": {
          "payment_date": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "payment_method": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "units",
    "listing_type",
    "asking_price"
  ]
}