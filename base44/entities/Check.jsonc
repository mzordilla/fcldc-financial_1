{
  "name": "Check",
  "type": "object",
  "properties": {
    "check_number": {
      "type": "string",
      "description": "Bank check number"
    },
    "payee": {
      "type": "string",
      "description": "Payee printed on the check"
    },
    "amount": {
      "type": "number",
      "description": "Check amount"
    },
    "amount_in_words": {
      "type": "string",
      "description": "Check amount written in words"
    },
    "bank_account_id": {
      "type": "string",
      "description": "Linked source BankAccount ID"
    },
    "bank_name": {
      "type": "string",
      "description": "Source bank name"
    },
    "account_name": {
      "type": "string",
      "description": "Source account name"
    },
    "account_number": {
      "type": "string",
      "description": "Source account number"
    },
    "check_date": {
      "type": "string",
      "format": "date"
    },
    "memo": {
      "type": "string",
      "description": "Check memo or payment purpose"
    },
    "source": {
      "type": "string",
      "enum": [
        "independent",
        "payment_approval"
      ],
      "default": "independent",
      "description": "Where the check was created"
    },
    "payment_request_ids": {
      "type": "array",
      "description": "Payment Requests paid by this check",
      "items": {
        "type": "string"
      }
    },
    "payment_request_numbers": {
      "type": "array",
      "description": "Payment Request references for register display",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "saved",
        "printed",
        "voided"
      ],
      "default": "saved"
    },
    "printed_date": {
      "type": "string",
      "description": "ISO timestamp of the latest print"
    },
    "deletion_request_status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "description": "Admin review status for removing a printed check"
    },
    "deletion_action": {
      "type": "string",
      "enum": [
        "void",
        "delete"
      ],
      "description": "Requested removal action"
    },
    "deletion_reason": {
      "type": "string",
      "description": "Reason for removing the printed check"
    },
    "deletion_requested_by": {
      "type": "string",
      "description": "Name of the requesting user"
    },
    "deletion_requested_date": {
      "type": "string",
      "description": "ISO timestamp of the request"
    },
    "deletion_reviewed_by": {
      "type": "string",
      "description": "Name of the admin reviewer"
    },
    "deletion_reviewed_date": {
      "type": "string",
      "description": "ISO timestamp of the review"
    }
  },
  "required": [
    "check_number",
    "payee",
    "amount",
    "bank_account_id",
    "check_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "disbursement"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}