{
  "name": "CompanySignature",
  "type": "object",
  "properties": {
    "signatory_name": {
      "type": "string",
      "description": "Name of the authorized company signatory"
    },
    "signatory_title": {
      "type": "string",
      "description": "Position or title of the authorized signatory"
    },
    "signature_url": {
      "type": "string",
      "description": "Uploaded signature image URL"
    }
  },
  "required": [
    "signatory_name",
    "signature_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}